<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- The IME owns light/dark palettes. Disable Force Dark on the actual window
         theme as well as its views: MIUI otherwise rewrites Canvas text colors. -->
    <style name="CupertinoImeWindow" parent="android:style/Theme.InputMethod">
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
    <style name="CupertinoBlurWindow" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
